PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/chhaya_studio
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
# Receives booking requests and 9:00 AM Asia/Kolkata event-day reminders.
ADMIN_NOTIFICATION_EMAIL=studio@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
# Use the studio's real contact email when deploying.
VAPID_SUBJECT=mailto:admin@example.com
# Use the MSG91 Authkey; the OTP template must contain ##OTP##.
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-approved-otp-template-id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=studio@example.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=Chhaya Picture <studio@example.com>
